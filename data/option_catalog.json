          "options": [
            {
              "id": "R1",
              "label": "OLS linear trend + HAC(1)"
            },
            {
              "id": "R2",
              "label": "Theil–Sen median pairwise slope"
            },
            {
              "id": "R3",
              "label": "Endpoint difference change per decade"
            }
          ]
        }
      ]
    },
