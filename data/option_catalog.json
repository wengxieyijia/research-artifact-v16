      "dimensions": [
        {
          "key": "D_TIME_WINDOW",
          "question": "Whether the analysis window covers all available years since 1970, or is shortened to test early/recent endpoint drivers.",
          "options": [
            {
              "id": "Y1",
              "label": "1970–2020 all available years"
            },
            {
              "id": "Y2",
              "label": "1970–2010 excluding 2020 endpoint"
            },
            {
              "id": "Y3",
              "label": "1980–2020 excluding 1970 start point"
            }
          ]
        },
        {
          "key": "D_WEALTH_LEVEL",
          "question": "Which regional household wealth position represents the region's household wealth distribution level.",
          "options": [
            {
              "id": "W1",
              "label": "Total wealth per household: wealth_total / hhlds"
            },
            {
              "id": "W2",
              "label": "Reported mean column: mean"
            },
            {
              "id": "W3",
              "label": "Reported median column: median"
            }
          ]
        },
        {
          "key": "D_TRIM",
          "question": "Whether to robustify extreme values in regional wealth level.",
          "options": [
            {
              "id": "T1",
              "label": "No trimming"
            },
            {
              "id": "T2",
              "label": "Winsorize regional wealth level at 1%/99% by year"
            }
          ]
        },
        {
          "key": "D_WEIGHT",
          "question": "How many households each region represents when calculating between-region Gini.",
          "options": [
            {
              "id": "G1",
              "label": "Weighted by hhlds household count"
            },
            {
              "id": "G2",
              "label": "Equal weight by region"
            }
          ]
        },
        {
          "key": "D_TREND_ESTIMATOR",
